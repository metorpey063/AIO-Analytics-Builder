#!/bin/bash
# ──────────────────────────────────────────────────────────
# AIO Builder — Daily Launcher
#
# Double-click to:
#   1. Auto-update from git (fast, ~2 seconds)
#   2. Kill any stale server process
#   3. Launch the web UI
#   4. Open browser
#
# Options (hold key while launching):
#   - Normal:       Update + launch
#   - If problems:  Delete .venv and reinstall deps (auto-detected)
# ──────────────────────────────────────────────────────────

# ── Terminal detection ──────────────────────────────────────
# When double-clicked from Finder, macOS runs this script headlessly
# (no terminal window). Detect that and re-launch inside Terminal.app.
if [ ! -t 1 ]; then
    SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    /usr/bin/osascript <<APPLESCRIPT
tell application "Terminal"
    activate
    do script "exec /bin/bash \"$SCRIPT_PATH\""
end tell
APPLESCRIPT
    exit 0
fi

# ── PATH hardening ──────────────────────────────────────────
# Ensure Homebrew and system tools are available (Finder launches
# with a minimal PATH that may exclude /opt/homebrew/bin, etc.)
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# Run Python natively: on Apple Silicon force arm64 (a Rosetta Terminal would load x86 wheels);
# Intel Macs have no arm64 slice, so run it directly
if [ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ]; then
    RUN_NATIVE="/usr/bin/arch -arm64"
else
    RUN_NATIVE=""
fi

# Auto-detect install dir: 3 levels up from this script (.app/Contents/MacOS/launch)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
INSTALL_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"

GREEN="\033[92m"
YELLOW="\033[93m"
RED="\033[91m"
BOLD="\033[1m"
RESET="\033[0m"

log() { echo -e "${GREEN}${BOLD}  → ${RESET}$1"; }
warn() { echo -e "${YELLOW}${BOLD}  ⚠ ${RESET}$1"; }

echo ""
echo -e "${BOLD}  AIO Analytics Builder${RESET}"
echo ""

# Check if installed
if [ ! -f "$INSTALL_DIR/web-ui/app.py" ]; then
    echo -e "${RED}  AIO is not installed at $INSTALL_DIR.${RESET}"
    echo ""
    echo "  Run this in Terminal to install:"
    echo ""
    echo "    curl -sL https://raw.githubusercontent.com/metorpey063/AIO-Analytics-Builder/main/install_remote.sh | bash"
    echo ""
    read -p "  Press Enter to exit..."
    exit 1
fi

cd "$INSTALL_DIR"

# ── Error logging ──────────────────────────────────────────
# Tee all output to a log file for debugging launch failures
LOG_FILE="$INSTALL_DIR/aio_launcher.log"
exec > >(tee -a "$LOG_FILE") 2>&1
echo "--- Launch: $(date) ---"

# Kill stale server
lsof -ti:5100 2>/dev/null | xargs kill 2>/dev/null

# Auto-update
log "Checking for updates..."
git fetch origin main --quiet 2>/dev/null
LOCAL=$(git rev-parse HEAD 2>/dev/null)
REMOTE=$(git rev-parse origin/main 2>/dev/null)

if [ "$LOCAL" != "$REMOTE" ] && git merge-base --is-ancestor "$REMOTE" "$LOCAL" 2>/dev/null; then
    # Only ahead: local commits not pushed yet and nothing new upstream. A reset would delete them.
    log "Local commits not on GitHub yet; nothing new to pull, skipping update"
elif [ "$LOCAL" != "$REMOTE" ]; then
    if ! git merge-base --is-ancestor "$LOCAL" "$REMOTE" 2>/dev/null; then
        # Diverged: keep the local commits on a branch before matching GitHub
        BACKUP="backup/pre-update-$(date +%Y%m%d-%H%M%S)"
        git branch "$BACKUP" "$LOCAL" 2>/dev/null && log "Saved local commits to branch $BACKUP"
    fi
    log "Updating..."
    git reset --hard origin/main 2>/dev/null


    log "Updated to latest!"
else
    log "Up to date"
fi

# Verify venv works (check all critical packages)
if ! $RUN_NATIVE .venv/bin/python -c "import flask, anthropic, pandas, numpy, requests, PyPDF2, docx" 2>/dev/null; then
    warn "Virtual environment broken — rebuilding..."
    rm -rf .venv
    PY=python3
    for c in python3.13 python3.12 python3.11 python3.10; do command -v "$c" &>/dev/null && PY="$c" && break; done
    "$PY" -m venv .venv
    .venv/bin/pip install --upgrade pip -q
    .venv/bin/pip install -r requirements.txt -q
    log "Rebuilt virtual environment"
fi

# Install any dependencies the current code needs that the venv lacks (covers updates made from
# the web UI's Update button or /update too). Quick when nothing is missing.
if [ -f deps.py ]; then
    $RUN_NATIVE .venv/bin/python deps.py || warn "Dependency install failed — try: .venv/bin/pip install -r requirements.txt"
fi

# Salesforce CLI (needed by Salesforce Automatic Setup); quick no-op once installed
[ -f install_sf_cli.sh ] && bash install_sf_cli.sh

# Clear stale Python cache
rm -rf web-ui/__pycache__ 2>/dev/null

# Launch
log "Starting server..."
echo ""
echo -e "  ${GREEN}${BOLD}✓ AIO Analytics Builder${RESET}"
echo "    http://localhost:5100"
echo ""
echo "  Press Ctrl+C to stop."
echo ""
echo "  ─────────────────────────────────────"
echo "  Trouble? Run these in Terminal:"
echo "    Clean update:  cd \"$INSTALL_DIR\" && git reset --hard origin/main && git pull"
echo "    Full rebuild:  cd \"$INSTALL_DIR\" && rm -rf .venv && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"
echo "  ─────────────────────────────────────"
echo ""

open "http://localhost:5100"
exec $RUN_NATIVE .venv/bin/python web-ui/app.py

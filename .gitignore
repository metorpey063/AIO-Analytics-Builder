# Credentials and local-only config — never commit
config.json
.claude/settings.local.json
CLAUDE.local.md
.pulse_validation_state.json
.pulse_validator.hyper

# Downloaded/generated artifacts
*.hyper
*.tdsx
*.command
hyperd.log

# Demo output — generated at runtime, not source
# Built demos carry customer names and data: never commit them (don't `git add -f`).
# Only AIO's own dashboard templates under demos/ are tracked.
demos/*
!demos/*_package.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# macOS
.DS_Store
.sf_pkg_offered
# Personal MCP config (may hold tokens)
.mcp.json

# Roadmap dashboard build state (owner only)
roadmap/roadmap_dashboard_checkpoint.json

# Config write lock and temp files
config.json.lock
.config.json.*.tmp

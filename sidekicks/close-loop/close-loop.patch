+def write_walkthrough(slug, cp, payload):
+    """Replace (or append) the 'Close the Loop' section in the demo's walkthrough .docx."""
+    path = cp.get("walkthrough") or next(iter(sorted(glob.glob(os.path.join(demo_dir(slug), "*walkthrough*.docx")))), None)
+    if not path or not os.path.exists(path) or os.path.basename(path).startswith("~$"):
+        print("No walkthrough .docx found — skipping Section 7 (talk track is in the payload JSON).")
+        return None
+    from docx import Document
+    doc = Document(path)
+    paras, drop = doc.paragraphs, False
+    for p in paras:
+        is_h1 = p.style.name == "Heading 1"
+        if is_h1:
+            drop = p.text.strip() == "Close the Loop"
+        if drop:
+            p._element.getparent().remove(p._element)
+    doc.add_heading("Close the Loop", level=1)
+    doc.add_paragraph(f"The demo ends with an action. The follow-up is built into the org — "
+                      f"{payload['action_reason']}. Trigger: {payload['trigger_label']}.")
+    for title, trig, result in payload["demo_steps"]:
+        doc.add_heading(title, level=2)
+        p = doc.add_paragraph()
+        p.add_run("Trigger: ").bold = True
+        p.add_run(trig)
+        p2 = doc.add_paragraph()
+        p2.add_run("Result: ").bold = True
+        p2.add_run(result)
+    doc.save(path)
+    return path
+
